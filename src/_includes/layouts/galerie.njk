---
layout: layouts/base.njk
---
{% set titre_banniere = titre %}
{% set chapeau = description %}
{% include "partials/banniere.njk" %}

<div class="container my-5">
    <div class="row">
        <div class="col-12">
            <p class="small text-muted">
                <time datetime="{{ date | dateISO }}">{{ date | dateFR }}</time>
                {% if section %} − {{ section }}{% endif %}
            </p>

            {{ content | safe }}
        </div>
    </div>

    {# Une colonne sur téléphone, deux dès `sm`, trois dès `lg` #}
    <div class="row g-4 mt-2">
        {% for photo in photos %}
        <div class="col-12 col-sm-6 col-lg-4">
            <figure class="mb-0">
                <img src="{{ photo.image }}" class="img-fluid d-block w-100" alt="{{ photo.legende or titre }}" loading="lazy">
                {% if photo.legende %}
                <figcaption class="small text-muted mt-2">{{ photo.legende }}</figcaption>
                {% endif %}
            </figure>
        </div>
        {% endfor %}
    </div>

    <p class="mt-5">
        <a href="/galeries/" class="fw-bold d-inline-block py-2">
            <i class="bi-chevron-left"></i> Toutes les galeries
        </a>
    </p>
</div>
