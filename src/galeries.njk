---
layout: layouts/base.njk
titre: Photos
chapeau: Les souvenirs de nos activités et de nos camps.
---
{% include "partials/banniere.njk" %}

<div class="container my-5">
    {% if collections.galeries.length %}
    <div class="row g-4">
        {% for galerie in collections.galeries %}
        <div class="col-12 col-sm-6 col-lg-4">
            <a href="{{ galerie.url }}" class="text-decoration-none">
                <div class="card h-100">
                    {% if galerie.data.photos and galerie.data.photos.length %}
                    <img src="{{ galerie.data.photos[0].image }}" class="card-img-top" alt="{{ galerie.data.titre }}" loading="lazy">
                    {% endif %}
                    <div class="card-body">
                        <h2 class="card-title h5 mb-1">{{ galerie.data.titre }}</h2>
                        <p class="small text-muted mb-0">
                            <time datetime="{{ galerie.data.date | dateISO }}">{{ galerie.data.date | dateFR }}</time>
                            {% if galerie.data.section %} − {{ galerie.data.section }}{% endif %}
                        </p>
                    </div>
                </div>
            </a>
        </div>
        {% endfor %}
    </div>
    {% else %}
    <p>Aucune galerie pour le moment.</p>
    {% endif %}
</div>
