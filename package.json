{
  "name": "@lesscouts/template-unite",
  "version": "1.0.0",
  "description": "Site d’unité Les Scouts : site public + interface d’administration",
  "author": "Les Scouts asbl (https://lesscouts.be/)",
  "contributors": [
    "Les Scouts asbl"
  ],
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lesscouts/template-unite.git"
  },
  "dependencies": {
    "bootstrap": "^5.1.3"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "eleventy --serve",
